# interop: run the upstream test suite and the checks against the
# stack in the guest.
#
# usage: make interop
#
# This program is the interop harness of TEST-INTEROP and the
# acceptance of TEST-ACCEPT. It is no .t file, and make check never
# runs it: it needs an OpenBSD guest, the fuguvm tool, and a checkout
# of the upstream server. mk/local.mk holds the interop target, and
# that target is the one caller.
#
# The harness runs on the host, on the Fugu library. It runs fuguvm
# as a command only, with Fugu::Process and an argument list, and it
# loads no App::FuguVM module (TEST-INTEROP-4). Each child gets its
# environment through the env option of Fugu::Process: the
# environment of the harness, and the fuguvm command (TEST-ACCEPT-3).
# A guest step is one 'fuguvm ssh -- sh -c <script>' call, so a step
# takes a redirect and a pipe, and each step is one call
# (TEST-INTEROP-4). The harness reads the exit code of each fuguvm
# call (TEST-INTEROP-5), and it stops at the first failed step with
# the output of that step.
#
# The guest is the guest of the .fuguvmrc of this repository. That
# file is local and untracked: it names a state directory of its own,
# so this guest is apart from the guest of any other harness, and it
# binds each forwarded port to the loopback address. The guest
# permits a root login with a generated password, so the developer
# runs the harness on a private host only (TEST-INTEROP-6).
#
# A run has three parts. The first part brings the provisioned guest
# up: 'fuguvm snapshot restore provisioned', then 'fuguvm up', then
# 'fuguvm wait'. Exit code 5 of the restore reports a running guest,
# and the harness stops the guest and restores again. Exit code 11
# reports no snapshot: the harness then destroys the disk, installs
# the guest again with 'fuguvm up', provisions it, stops it, and
# saves the snapshot (TEST-INTEROP-5). Exit code 7 of the wait
# reports a timeout. The provisioning holds, one call for each step:
# the packages, then regress/guest for the library, the programs and
# the regression tests, then the upstream checkout and the Python
# distributions by 'fuguvm put', then a venv, then the pip run, then
# an import of wallycore, flask and requests. A change of one of these
# steps needs a new snapshot: run 'fuguvm snapshot rm provisioned'.
#
# The second part deploys the tree. The harness puts the tracked files
# of the working tree into the guest with 'fuguvm put', and the guest
# builds them (ARCH-DEPS-5). The guest builds the CGI program a second
# time, as the regress build of regress/Makefile with the two paths of
# a second instance inside the httpd chroot: its own record directory
# and its own key file under /fuguoracle-fixed. One step creates the
# service account and the two directories of PKG-ORACLE-2 and
# PKG-ORACLE-3, and the same two directories of the fixed instance.
# One step installs the CGI program into the httpd chroot, the regress
# build beside it as fuguoracle-fixed, and the key generator into
# /usr/local/sbin. The harness puts the rc.d script and the httpd.conf
# fragment of ports/security/fuguoracle in the same way
# (TEST-INTEROP-7). The test config holds two server blocks. The first
# one is the fragment with 'listen on lo0 port 8080' in place of the
# TLS listen line and without the tls block, because the test needs no
# certificate. The second one is the fragment again, on port 8081,
# with the second program in place of the first and one more FastCGI
# parameter: FUGUORACLE_RANDOM, the fixed random file, so the seam of
# the regress build reads that file (SEC-RANDOM-2). slowcgi(8) runs
# the program that SCRIPT_FILENAME names and holds no state of a
# program, so both blocks name the one socket of the rc.d script.
# fuguoracle-keygen then makes a fresh key, and the fixed instance
# gets a copy of it. rcctl starts httpd and the fuguoracle service.
# The harness then starts regress/upstream-fixed.py: the upstream
# server on a copy of the same key and on the same random file, on
# port 8082 (D-12). That start is one simple command in the
# background, and no compound list: ksh(1) forks a subshell for a
# list, and that subshell waits for the server with a copy of the
# SSH channel open, so the step never returns.
#
# regress/random.bin is the one fixed random source (TEST-ACCEPT-3),
# and the harness puts it into the record directory of the fixed
# instance, because the program unveils that directory and the key
# file alone. The largest row of the draw table of TEST-ACCEPT-2 is
# 64 bytes: the server entropy (32), the storage IV (16) and the
# response IV (16). One request of the service is one process, and
# the seam opens the file at the first draw of that process, so each
# request reads the file from its first byte, and the upstream wrapper
# rewinds the file before each request. A run therefore needs 64
# bytes, and the file holds 256: four times the largest row, so a draw
# beyond the table moves a later draw and fails the comparison, and it
# stops no server. 'dd if=/dev/urandom of=regress/random.bin bs=64
# count=4' wrote the file once. The bytes are test data, not a secret.
#
# The third part is the check. The harness puts
# regress/interop-upstream.py into the guest and runs it there. The
# header of that program names the tests of the upstream suite that
# run against the stack, and the tests that do not. The harness then
# puts regress/interop-checks.py and runs it: the junk uniformity, the
# failure table, and the byte identity of the two fixed servers
# (TEST-INTEROP-2, TEST-INTEROP-3, TEST-ACCEPT-1). The harness copies
# each report out with 'fuguvm get' into scratch/ (TEST-INTEROP-7), it
# prints one TAP line for each test, and it exits non-zero on any
# failure.
#
# The guest runs nothing on the host, and the harness runs no shell
# on the host: each host command is a list.
#
# These are the environment variables:
#
#	FUGUVM	The fuguvm command. The default is fuguvm of the
#		PATH. fuguvm needs the modules of FuguVM and the
#		agent socket of the guest, so the caller sets
#		PERL5LIB and SSH_AUTH_SOCK for it.
#
#	FUGUORACLE_SECP256K1
#		The libsecp256k1 release tarball. regress/guest takes
#		it, and its header states the source of it.
#
#	FUGUORACLE_BLIND_PIN_SERVER
#		The directory of a git checkout of the upstream
#		blind_pin_server. The harness puts the tracked files
#		of that checkout into the guest as the package
#		blind_pin_server, so the venv and the keys of the
#		checkout stay on the host. The tested upstream is
#		the commit that $UPSTREAM_COMMIT holds below, and the
#		harness warns when HEAD of the checkout differs.
#
#	FUGUORACLE_PYPI
#		The directory of the Python distributions that the
#		requirements file of the checkout pins: one wheel or
#		one source archive for each pin. regress/pypi-fetch
#		builds that directory from the requirements file. The
#		guest reaches no package index, so pip reads this
#		directory alone.
#
# The location of a checkout of a third-party server, and of a set of
# third-party distributions, is no design fact of FuguOracle, so no
# document of spec/ names these variables.

use v5.34;
use warnings;
use experimental 'signatures';
no feature qw(indirect multidimensional bareword_filehandles);

use File::Basename qw(dirname);
use File::Copy     qw(copy);
use File::Path     qw(make_path);
use File::Temp     ();
use FindBin        qw($RealBin);

use Fugu::Process;

my $ROOT   = dirname($RealBin);
my $FUGUVM = $ENV{FUGUVM} // 'fuguvm';

# The environment of each child (TEST-ACCEPT-3).
my $CHILD_ENV = { %ENV, FUGUVM => $FUGUVM };

# The snapshot of the provisioned guest.
my $SNAPSHOT = 'provisioned';

# The work directory of the guest. It sits on /home, because the root
# partition of the guest holds a few hundred megabytes only. It is
# apart from the directory of regress/guest.
my $WORK = '/home/fuguoracle/interop';

# The public endpoint of the stack in the guest, without TLS.
my $PORT = 8080;
my $URL  = "http://127.0.0.1:$PORT";

# The endpoint of the fixed instance of the service, and the paths of
# that instance inside the httpd chroot.
my $FIXED_PORT = 8081;
my $FIXED_URL  = "http://127.0.0.1:$FIXED_PORT";
my $FIXED      = '/fuguoracle-fixed';
my $RANDOM     = "$FIXED/pins/random.bin";

# The endpoint of the upstream server on the fixed random file.
my $UPSTREAM_PORT = 8082;
my $UPSTREAM_URL  = "http://127.0.0.1:$UPSTREAM_PORT";

# The tested upstream: the commit of blind_pin_server that the tests
# of this harness passed against.
my $UPSTREAM_COMMIT = '62b920ef50b8e035d26916d9ed77b42903664993';

# The packages of the provisioning, beside the autotools that
# regress/guest installs. The pip run builds wallycore from source: it
# needs gmake for the automake tree, bash for a script of that tree,
# and swig for the wrapper that the same tree removes.
my $PACKAGES = 'python%3 py3-pip bash gmake swig';

# The reports of the two check programs, on the host.
my %REPORT = (
	upstream => "$ROOT/scratch/interop-upstream.txt",
	checks   => "$ROOT/scratch/interop-checks.txt"
);

# The seconds of one host command, one guest command, the SSH wait,
# one build, and the pip run. The wallycore build takes about nine
# minutes.
my %TIMEOUT = (
	host  => 120,
	guest => 900,
	wait  => 300,
	build => 1800,
	pip   => 2400
);

# The exit codes of fuguvm that the harness reads (TEST-INTEROP-5).
my %FUGUVM_EXIT = (
	5  => 'the guest runs',
	7  => 'a timeout',
	11 => 'no snapshot'
);

# The script of the service account and the two directories
# (PKG-ORACLE-2, PKG-ORACLE-3), and of the same two directories of
# the fixed instance. It creates what is absent, and it keeps what is
# in place. useradd(8) runs pwd_mkdb(8) in the background, so the
# script waits for the passwd entry.
my $ACCOUNT = <<"SH";
set -e
user=_fuguoracle
getent group \$user > /dev/null 2>&1 || groupadd \$user
if ! getent passwd \$user > /dev/null 2>&1; then
	useradd -g \$user -d /var/empty -s /sbin/nologin \$user
	try=0
	while ! getent passwd \$user > /dev/null 2>&1; do
		try=\$((try + 1))
		[ \$try -lt 10 ] || exit 1
		sleep 1
	done
fi
for dir in /var/www/fuguoracle /var/www$FIXED; do
	mkdir -p \$dir/pins
	chown root:\$user \$dir
	chmod 0710 \$dir
	chown \$user:\$user \$dir/pins
	chmod 0700 \$dir/pins
done
SH

# The script of the test config, from the fragment at $WORK/httpd.conf.
# plain() writes the fragment with a plain listen line on one port and
# without the tls block. The second block drops the comment lines,
# takes another name, names the second program, and appends the
# FastCGI parameter of the fixed random file after each
# SCRIPT_FILENAME line.
my $HTTPD = <<"SH";
set -e
plain() {
	sed -e "s/listen on egress tls port 443/listen on lo0 port \$1/" \\
	    -e '/^[[:blank:]]tls {\$/,/^[[:blank:]]}\$/d' $WORK/httpd.conf
}
plain $PORT > /etc/httpd.conf
plain $FIXED_PORT | sed -e '/^#/d' -e 's/^server .*/server "fixed" {/' \\
    -e 's#/cgi-bin/fuguoracle"#/cgi-bin/fuguoracle-fixed"#' \\
    -e '/param SCRIPT_FILENAME/a\\
param FUGUORACLE_RANDOM "$RANDOM"' >> /etc/httpd.conf
httpd -n
SH

# The script of the key: a fresh key of the service, a copy of it
# for the fixed instance, and no record in either instance. The
# public key is the one line of standard output.
my $KEY = <<"SH";
set -e
rm -f /var/www/fuguoracle/pins/*.pin /var/www/fuguoracle/private.key
rm -f /var/www$FIXED/pins/*.pin /var/www$FIXED/private.key
fuguoracle-keygen
install -o _fuguoracle -g _fuguoracle -m 0400 \\
    /var/www/fuguoracle/private.key /var/www$FIXED/private.key
SH

# The make shim of the pip run. BSD make cannot run the automake tree
# of wallycore, and the build reads make and python from the PATH, so
# the pip step puts the shim directory and the venv on the PATH.
my $SHIM = "#!/bin/sh\nexec /usr/local/bin/gmake \"\$@\"\n";

# failure($what, $result):
#	The message of one failed command: the reason, and the two
#	streams of the command.
sub failure ( $what, $result )
{
	my $code   = $result->{exit_code} // -1;
	my $reason = $result->{error}     // (
		$result->{timed_out}
		? "no answer in the timeout"
		: "exit $code"
		    . ( $FUGUVM_EXIT{$code} ? ", $FUGUVM_EXIT{$code}" : q{} ) );
	return
	      "interop: $what: $reason\n"
	    . ( $result->{stdout} // q{} )
	    . ( $result->{stderr} // q{} );
}

# step($what):
#	One progress line, as a TAP comment.
sub step ($what)
{
	say "# $what";
	return;
}

# reach(@urls):
#	The shell text that waits for each URL: ten tries, one second
#	apart, and exit 1 when one URL answers nothing.
sub reach (@urls)
{
	return join q{}, map {
		      "try=0; until ftp -Vo /dev/null $_/; do "
		    . "try=\$((try + 1)); [ \$try -lt 10 ] || exit 1; "
		    . "sleep 1; done\n"
	} @urls;
}

# host($cmd, %args):
#	Run one host command from the repository root, with the
#	environment of each child, and give the result hash of
#	Fugu::Process->run().
sub host ( $cmd, %args )
{
	return Fugu::Process->run(
		cmd     => $cmd,
		cwd     => $ROOT,
		env     => $CHILD_ENV,
		timeout => $TIMEOUT{host},
		%args
	);
}

# host_ok($what, $cmd, %args):
#	Run one host command, and give its standard output. A failure
#	ends the run.
sub host_ok ( $what, $cmd, %args )
{
	my $result = host( $cmd, %args );
	die failure( $what, $result ) unless $result->{success};
	return $result->{stdout};
}

# fuguvm(@args):
#	Run fuguvm with @args, and give the result hash.
sub fuguvm (@args)
{
	return host( [ $FUGUVM, @args ], timeout => $TIMEOUT{guest} );
}

# fuguvm_ok($what, @args):
#	Run fuguvm with @args. A failure ends the run.
sub fuguvm_ok ( $what, @args )
{
	return host_ok( $what, [ $FUGUVM, @args ], timeout => $TIMEOUT{guest} );
}

# guest($script, $timeout):
#	Run one shell script in the guest, and give the result hash.
sub guest ( $script, $timeout = $TIMEOUT{guest} )
{
	return host( [ $FUGUVM, 'ssh', '--', 'sh', '-c', $script ],
		timeout => $timeout );
}

# guest_ok($what, $script, $timeout):
#	Run one shell script in the guest, and give its standard
#	output. A failure ends the run.
sub guest_ok ( $what, $script, $timeout = $TIMEOUT{guest} )
{
	my $result = guest( $script, $timeout );
	die failure( $what, $result ) unless $result->{success};
	return $result->{stdout};
}

# put($local, $remote, @flags):
#	Copy one host file or directory into the guest.
sub put ( $local, $remote, @flags )
{
	fuguvm_ok( "fuguvm put $remote", 'put', @flags, "$local", $remote );
	return;
}

# tracked($dir):
#	A temporary directory with a copy of the tracked files of the
#	git working tree at $dir, with the mode of each file. The copy
#	holds no ignored file and no untracked file, so 'fuguvm put'
#	of it carries no venv, no key and no git metadata.
sub tracked ($dir)
{
	my $stage = File::Temp->newdir(
		TEMPLATE => 'fuguoracle-tree-XXXXXX',
		TMPDIR   => 1
	);
	my $list = host_ok( "git ls-files of $dir",
		[ 'git', '-C', $dir, 'ls-files', '-z' ] );
	for my $file ( grep { length } split /\0/, $list ) {
		my $from = "$dir/$file";
		my $to   = "$stage/$file";
		make_path( dirname($to) );
		copy( $from, $to ) or die "interop: $from: $!\n";
		chmod( ( stat $from )[2] & 0777, $to )
		    or die "interop: $to: $!\n";
	}
	return $stage;
}

# provision():
#	The steps of a fresh guest, up to the snapshot.
sub provision ()
{
	step('the packages');
	guest_ok( 'the packages', "pkg_add -I $PACKAGES", $TIMEOUT{build} );

	step('the library, the programs and the regression tests');
	host_ok(
		'regress/guest',
		[ "$ROOT/regress/guest", $ENV{FUGUORACLE_SECP256K1} ],
		timeout => $TIMEOUT{build} );

	step('the upstream checkout');
	my $upstream = $ENV{FUGUORACLE_BLIND_PIN_SERVER};
	my $head     = host_ok( 'git rev-parse',
		[ 'git', '-C', $upstream, 'rev-parse', 'HEAD' ] );
	chomp $head;
	warn "interop: $upstream is at $head, and the tested upstream "
	    . "is $UPSTREAM_COMMIT\n"
	    if $head ne $UPSTREAM_COMMIT;
	guest_ok(
		'the work directory',
		"rm -rf $WORK && mkdir -p $WORK/blind_pin_server "
		    . "$WORK/dist $WORK/bin $WORK/tmp $WORK/run"
	);
	put( tracked($upstream), "$WORK/blind_pin_server" );

	step('the Python distributions');
	put( $ENV{FUGUORACLE_PYPI}, "$WORK/dist" );

	step('the venv');
	my $shim = File::Temp->new(
		TEMPLATE => 'fuguoracle-make-XXXXXX',
		TMPDIR   => 1
	);
	print {$shim} $SHIM or die "interop: the shim: $!\n";
	close $shim         or die "interop: the shim: $!\n";
	put( "$shim", "$WORK/bin/make", '--mode', '0755' );
	guest_ok( 'the venv',
		"cd $WORK && rm -rf venv && python3 -m venv venv" );

	step('the pip run');
	guest_ok(
		'the pip run',
"cd $WORK && PATH=$WORK/bin:$WORK/venv/bin:\$PATH TMPDIR=$WORK/tmp "
		    . "AUTOCONF_VERSION=2.71 AUTOMAKE_VERSION=1.16 "
		    . "venv/bin/pip install --no-index --find-links $WORK/dist "
		    . "--require-hashes -r blind_pin_server/requirements.txt",
		$TIMEOUT{pip} );

	step('the import');
	guest_ok(
		'the import',
		"$WORK/venv/bin/python -c 'import wallycore, flask, requests'"
	);
	return;
}

# ready():
#	The provisioned guest, up and reachable. The snapshot gives
#	it, and a fresh guest gets provisioned and saved first
#	(TEST-INTEROP-5).
sub ready ()
{
	step("the snapshot $SNAPSHOT");
	my $result = fuguvm( 'snapshot', 'restore', $SNAPSHOT );
	if ( ( $result->{exit_code} // -1 ) == 5 ) {
		fuguvm_ok( 'fuguvm down', 'down' );
		$result = fuguvm( 'snapshot', 'restore', $SNAPSHOT );
	}
	if ( !$result->{success} ) {
		die failure( 'fuguvm snapshot restore', $result )
		    unless ( $result->{exit_code} // -1 ) == 11;

		step('the guest, installed again');
		fuguvm_ok( 'fuguvm down',    'down' );
		fuguvm_ok( 'fuguvm destroy', 'destroy' );
		fuguvm_ok( 'fuguvm up',      'up' );
		fuguvm_ok( 'fuguvm wait', 'wait', '--timeout', $TIMEOUT{wait} );
		provision();
		fuguvm_ok( 'fuguvm down', 'down' );
		fuguvm_ok( 'fuguvm snapshot save',
			'snapshot', 'save', $SNAPSHOT );
	}

	step('the guest');
	fuguvm_ok( 'fuguvm up', 'up' );
	fuguvm_ok( 'fuguvm wait', 'wait', '--timeout', $TIMEOUT{wait} );
	return;
}

# deploy():
#	The stack in the guest, from the working tree: the service,
#	the fixed instance of it, and the upstream server on the fixed
#	random file. Gives the public key of the service, as hex.
sub deploy ()
{
	step('the tree');
	guest_ok( 'the source directory',
		"rm -rf $WORK/src && mkdir -p $WORK/src $WORK/run" );
	put( tracked($ROOT), "$WORK/src" );

	step('the build');
	guest_ok(
		'the build',
		"cd $WORK/src && make && make -C regress cgi "
		    . "PINS_DIR=$FIXED/pins KEY_PATH=$FIXED/private.key",
		$TIMEOUT{build}
	);

	step('the service account');
	guest_ok( 'the service account', $ACCOUNT );

	step('the programs');
	guest_ok(
		'the programs',
		"cd $WORK/src && install -o root -g bin -m 0555 fuguoracle "
		    . "/var/www/cgi-bin/fuguoracle && install -o root -g bin "
		    . "-m 0555 regress/cgi /var/www/cgi-bin/fuguoracle-fixed && "
		    . "install -o root -g bin -m 0555 fuguoracle-keygen "
		    . "/usr/local/sbin/fuguoracle-keygen"
	);

	step('the rc.d script');
	put( "$ROOT/ports/security/fuguoracle/pkg/fuguoracle.rc",
		'/etc/rc.d/fuguoracle', '--mode', '0555' );

	step('the httpd.conf');
	put( "$ROOT/ports/security/fuguoracle/files/httpd.conf",
		"$WORK/httpd.conf" );
	guest_ok( 'the httpd.conf', $HTTPD );

	step('the key');
	my $key = guest_ok( 'the key', $KEY );
	chomp $key;
	die "interop: the key: fuguoracle-keygen printed no public key: $key\n"
	    unless $key =~ /\A[0-9a-f]{66}\z/;

	step('the fixed random file');
	put( "$ROOT/regress/random.bin", "/var/www$RANDOM", '--mode', '0444' );

	step('the services');
	guest_ok(
		'the services',
		"set -e\nrcctl enable httpd fuguoracle\n"
		    . "rcctl restart fuguoracle httpd\n"
		    . reach( $URL, $FIXED_URL )
	);

	step('the upstream server on the fixed random file');
	put( "$ROOT/regress/upstream-fixed.py", "$WORK/upstream-fixed.py" );
	guest_ok(
		'the upstream server',
		"set -e\nrm -rf $WORK/fixed && mkdir -p $WORK/fixed/pins\n"
		    . "install -m 0600 /var/www/fuguoracle/private.key "
		    . "$WORK/fixed/server_private_key.key\n"
		    . "cd $WORK/fixed\n"
		    . "PYTHONPATH=$WORK nohup $WORK/venv/bin/python "
		    . "$WORK/upstream-fixed.py /var/www$RANDOM $UPSTREAM_PORT "
		    . "< /dev/null > $WORK/fixed/server.log 2>&1 &\n"
		    . reach($UPSTREAM_URL)
	);
	return $key;
}

# report($what, $program, $report, $count):
#	Run one unittest program in the run directory of the guest,
#	copy its report to $report on the host (TEST-INTEROP-7), and
#	print one TAP line for each test, numbered from $$count on.
#	Gives the count of failed tests. A run that failed, or that
#	ran no test, ends the harness with the report on standard
#	error.
sub report ( $what, $program, $report, $count )
{
	my $result =
	    guest(    "cd $WORK/run && PYTHONPATH=$WORK TMPDIR=$WORK/tmp "
		    . "$WORK/venv/bin/python $program "
		    . "> $WORK/report.txt 2>&1" );
	make_path( dirname($report) );
	fuguvm_ok( 'fuguvm get', 'get', "$WORK/report.txt", $report );

	open my $fh, '<', $report or die "interop: $report: $!\n";
	my ( $tests, $failed ) = ( 0, 0 );
	while ( my $line = <$fh> ) {
		my ( $name, $verdict ) =
		    $line =~ /\A(test_\w+) \(.*\) \.\.\. (ok|FAIL|ERROR)\s*\z/
		    or next;
		$tests++;
		$$count++;
		if ( $verdict eq 'ok' ) {
			say "ok $$count - $name";
		}
		else {
			$failed++;
			say "not ok $$count - $name";
		}
	}
	close $fh;

	return $failed if $result->{success} && $tests;
	open $fh, '<', $report or die "interop: $report: $!\n";
	print STDERR <$fh>;
	close $fh;
	die failure( $what, $result ) if !$result->{success};
	die "interop: $what ran no test\n";
}

# check($key):
#	The upstream test suite and the checks against the stack, and
#	the TAP lines of both. Gives the count of failed tests.
sub check ($key)
{
	my $count = 0;

	step('the upstream test suite');
	put( "$ROOT/regress/interop-upstream.py", "$WORK/interop-upstream.py" );
	guest_ok(
		'the run directory',
"rm -f $WORK/run/pins && ln -s /var/www/fuguoracle/pins $WORK/run/pins"
	);
	my $failed = report( 'the upstream test suite',
		"$WORK/interop-upstream.py $URL $key",
		$REPORT{upstream}, \$count );

	step('the checks');
	put( "$ROOT/regress/interop-checks.py", "$WORK/interop-checks.py" );
	$failed += report( 'the checks',
		"$WORK/interop-checks.py $URL $FIXED_URL $UPSTREAM_URL $key",
		$REPORT{checks}, \$count );

	say "1..$count";
	return $failed;
}

for my $name (
	qw(FUGUORACLE_SECP256K1 FUGUORACLE_BLIND_PIN_SERVER FUGUORACLE_PYPI))
{
	die "interop: $name is not set; the header of regress/interop "
	    . "states each variable\n"
	    unless defined $ENV{$name} && length $ENV{$name};
}
die "interop: $ENV{FUGUORACLE_SECP256K1}: no such file\n"
    unless -f $ENV{FUGUORACLE_SECP256K1};
die "interop: $ENV{FUGUORACLE_BLIND_PIN_SERVER}: no such directory\n"
    unless -d $ENV{FUGUORACLE_BLIND_PIN_SERVER};
die "interop: $ENV{FUGUORACLE_PYPI}: no such directory\n"
    unless -d $ENV{FUGUORACLE_PYPI};

ready();
my $failed = check( deploy() );
exit( $failed ? 1 : 0 );
